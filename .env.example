# Copy to `.env` and fill in. `.env` is git-ignored and must never be committed.
#
# Only the variables used by the current milestone are listed. Integration
# credentials (Meta Cloud API, Monday.com, Google Calendar, Anthropic) are added
# here as those milestones land.

# --- Runtime -----------------------------------------------------------------

# One of: development | test | production
NODE_ENV=development

# Port for the HTTP server (WhatsApp webhooks + admin API).
PORT=3000

# One of: fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# IANA timezone driving all business-hours logic: working hours, Shabbat
# handling, and follow-up scheduling. Server clocks are UTC, so this is set
# explicitly rather than inherited from the host.
APP_TIMEZONE=Asia/Jerusalem

# --- PostgreSQL --------------------------------------------------------------
# The system's source of truth. Monday.com is only a projection of this data.
# Must match the credentials in docker-compose.yml for local development.

DATABASE_URL=postgresql://lidor:lidor_dev_password@localhost:5432/lidor_bot

# Used by docker-compose.yml when starting the local database.
POSTGRES_USER=lidor
POSTGRES_PASSWORD=lidor_dev_password
POSTGRES_DB=lidor_bot
POSTGRES_PORT=5432

# --- Redis -------------------------------------------------------------------
# BullMQ queues only (follow-up delays, outbox delivery, retries). Never holds
# authoritative state — schedules are recoverable from PostgreSQL.

REDIS_URL=redis://localhost:6379
REDIS_PORT=6379

# --- Meta WhatsApp Cloud API -------------------------------------------------
# Optional as a group. Without them the app starts and serves /health, but the
# webhook endpoints return 503 rather than accepting requests they cannot
# verify — it fails closed, never open.
#
# Obtain from developers.facebook.com → your App → WhatsApp.

# App secret, used to verify the X-Hub-Signature-256 header on every webhook.
# This is the only thing preventing anyone who learns the webhook URL from
# injecting fake inbound messages.
META_APP_SECRET=

# A shared secret you choose. Enter the same value in the Meta App dashboard
# when subscribing the webhook; Meta echoes it back during the handshake.
# Any long random string is fine, e.g. `openssl rand -hex 32`.
META_WEBHOOK_VERIFY_TOKEN=

# Long-lived access token for the WhatsApp Business Account.
META_ACCESS_TOKEN=

# The bot number's phone number ID — the Graph API identifier, not the number
# itself. Found under WhatsApp → API Setup.
META_PHONE_NUMBER_ID=

# Graph API version, pinned so Meta cannot change behaviour under us.
META_GRAPH_API_VERSION=v21.0

# --- Meta Lead Ads (leadgen intake) -------------------------------------------
# Retrieving a lead's submitted answers uses a *Page* access token carrying the
# `leads_retrieval` permission — a different credential from the WhatsApp token
# above. Without it the leadgen webhook fails closed with a 503 (so Meta
# redelivers) rather than acknowledging a paid lead it cannot store.
META_PAGE_ACCESS_TOKEN=

# Lead form ids whose leads enter the SELLER qualification flow, comma-separated.
#
# The Page runs investor and recruitment campaigns alongside the seller ones.
# Leads from unlisted forms are recorded for attribution but never engaged —
# an investor must not be asked which neighbourhood their property is in.
# Empty engages nothing.
#
# Known seller forms:
#   1746567036243410  טופס לידים למוכרי נכסים | 22/08/26   (current campaign)
#   2080005129480041  טופס לידים למוכרי נכסים | ווינרס
#   4302155423438553  טופס למוכרי נכסים 27.11.2025
# Known non-seller forms (investor / recruitment) — do NOT list these:
#   1299747795289551, 24653480120972102, 2218963621849935
META_LEAD_SELLER_FORMS=1746567036243410

# Lead form ids whose submission constitutes WhatsApp opt-in, comma-separated.
#
# Meta does NOT return privacy-step disclaimer checkboxes in a lead's field_data,
# even when required — so per-lead detection alone would mean no lead is ever
# contactable. A form may be listed here when it carries a REQUIRED, not
# pre-checked consent checkbox naming WhatsApp and the business. Meta forms are
# immutable, so a form id permanently identifies the exact wording agreed to.
#
# Only list a form you have verified. Unlisted forms stay privacy_policy_only and
# cannot be proactively messaged. See docs/PRODUCT-REQUIREMENTS.md rule NN-2.
#
# Verify with:
#   curl -s -G "https://graph.facebook.com/v21.0/<FORM_ID>" \
#     -d "fields=legal_content" -H "Authorization: Bearer $META_PAGE_ACCESS_TOKEN"
# and confirm custom_disclaimer.checkboxes[].is_required is true.
META_LEAD_CONSENT_FORMS=

# The consent wording recorded as evidence for form-level consent. Copy verbatim
# from the form's custom_disclaimer checkbox text.
META_LEAD_CONSENT_TEXT=

# For a form that asks consent as an ordinary question instead of a disclaimer
# checkbox: the field_data key holding the answer. Stronger evidence than the
# form-level rule and takes precedence over it. The current seller form does not
# have one, so this stays unset.
META_LEAD_CONSENT_FIELD=

# The exact answer that counts as consent, for a checkbox that echoes its label
# back instead of a boolean. Unset accepts the usual affirmatives (true/yes/כן).
META_LEAD_CONSENT_VALUE=

# --- Anthropic (LLM) ---------------------------------------------------------
# The model that classifies messages and writes replies. Optional as a group
# with the Meta credentials: absent it, the app runs ingestion-only and the
# conversation worker stays disabled.

# API key for the Anthropic Messages API.
ANTHROPIC_API_KEY=
