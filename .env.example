# Copy to `.env` and fill in. `.env` is git-ignored and must never be committed.
#
# Only the variables used by the current milestone are listed. Integration
# credentials (Meta Cloud API, Monday.com, Google Calendar, Anthropic) are added
# here as those milestones land.

# --- Runtime -----------------------------------------------------------------

# One of: development | test | production
NODE_ENV=development

# Port for the HTTP server (WhatsApp webhooks + admin API).
PORT=3000

# One of: fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# IANA timezone driving all business-hours logic: working hours, Shabbat
# handling, and follow-up scheduling. Server clocks are UTC, so this is set
# explicitly rather than inherited from the host.
APP_TIMEZONE=Asia/Jerusalem

# --- PostgreSQL --------------------------------------------------------------
# The system's source of truth. Monday.com is only a projection of this data.
# Must match the credentials in docker-compose.yml for local development.

DATABASE_URL=postgresql://lidor:lidor_dev_password@localhost:5432/lidor_bot

# Used by docker-compose.yml when starting the local database.
POSTGRES_USER=lidor
POSTGRES_PASSWORD=lidor_dev_password
POSTGRES_DB=lidor_bot
POSTGRES_PORT=5432

# --- Redis -------------------------------------------------------------------
# BullMQ queues only (follow-up delays, outbox delivery, retries). Never holds
# authoritative state — schedules are recoverable from PostgreSQL.

REDIS_URL=redis://localhost:6379
REDIS_PORT=6379

# --- Meta WhatsApp Cloud API -------------------------------------------------
# Optional as a group. Without them the app starts and serves /health, but the
# webhook endpoints return 503 rather than accepting requests they cannot
# verify — it fails closed, never open.
#
# Obtain from developers.facebook.com → your App → WhatsApp.

# App secret, used to verify the X-Hub-Signature-256 header on every webhook.
# This is the only thing preventing anyone who learns the webhook URL from
# injecting fake inbound messages.
META_APP_SECRET=

# A shared secret you choose. Enter the same value in the Meta App dashboard
# when subscribing the webhook; Meta echoes it back during the handshake.
# Any long random string is fine, e.g. `openssl rand -hex 32`.
META_WEBHOOK_VERIFY_TOKEN=

# Long-lived access token for the WhatsApp Business Account.
META_ACCESS_TOKEN=

# The bot number's phone number ID — the Graph API identifier, not the number
# itself. Found under WhatsApp → API Setup.
META_PHONE_NUMBER_ID=

# Graph API version, pinned so Meta cannot change behaviour under us.
META_GRAPH_API_VERSION=v21.0

# --- Anthropic (LLM) ---------------------------------------------------------
# The model that classifies messages and writes replies. Optional as a group:
# in stub mode (below) it is not needed.

# API key for the Anthropic Messages API.
ANTHROPIC_API_KEY=

# Which LLM backend the conversation worker uses:
#   live  (default) — calls the real Anthropic API.
#   stub            — a local, deterministic stand-in that answers WITHOUT any
#                     API call, for testing the WhatsApp round trip without
#                     spending tokens on every message. ANTHROPIC_API_KEY is not
#                     required in stub mode.
LLM_MODE=live
