# Production `.env` — copy to the repository root on the server as `.env`.
# Everything from .env.example applies; these are the values that differ in
# production, plus the ones only the production stack uses. Never commit it.

NODE_ENV=production
PORT=3000
LOG_LEVEL=info
APP_TIMEZONE=Asia/Jerusalem

# --- The stack (docker-compose.prod.yml) --------------------------------------
# Public hostname; Caddy obtains the TLS certificate for it. Its DNS A record
# must point at this server before the first start.
DOMAIN=bot.example.co.il

# Postgres inside the stack. Hostnames are the compose service names.
POSTGRES_USER=lidor
POSTGRES_PASSWORD=            # openssl rand -hex 24
POSTGRES_DB=lidor_bot
DATABASE_URL=postgresql://lidor:<the same password>@postgres:5432/lidor_bot
REDIS_URL=redis://redis:6379

# Nightly backups → S3. An IAM user with PutObject/GetObject/ListBucket on this
# bucket only (policy in docs/GO-LIVE.md). Retention is a bucket lifecycle rule.
BACKUP_S3_URI=s3://<bucket>/lidor-bot
BACKUP_AWS_ACCESS_KEY_ID=
BACKUP_AWS_SECRET_ACCESS_KEY=
BACKUP_AWS_REGION=il-central-1
# BACKUP_CRON=30 0 * * *      # UTC; default is 03:30 Israel time

# --- Meta ----------------------------------------------------------------------
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=    # openssl rand -hex 32; enter the same in Meta
META_ACCESS_TOKEN=            # System User token, never a temporary one
META_PHONE_NUMBER_ID=         # Lidor's business number, not the test number
META_GRAPH_API_VERSION=v21.0
META_PAGE_ACCESS_TOKEN=
META_LEAD_SELLER_FORMS=1746567036243410
META_LEAD_CONSENT_FORMS=1746567036243410
META_LEAD_CONSENT_TEXT=

# --- Outreach and follow-ups ---------------------------------------------------
# Flip to true only after Meta Business verification (E-1) and the go-live
# checklist in docs/GO-LIVE.md.
OUTREACH_ENABLED=false
OUTREACH_TEMPLATE_NAME=welcome_message
OUTREACH_TEMPLATE_LANGUAGE=he
FOLLOWUP_TEMPLATE_NAME=seller_followup_1
FOLLOWUP_INCOMPLETE_TEMPLATE_NAME=seller_followup_incomplete
FOLLOWUP_TEMPLATE_LANGUAGE=he

# --- Monday / Anthropic ---------------------------------------------------------
MONDAY_API_TOKEN=
MONDAY_API_VERSION=2024-10
ANTHROPIC_API_KEY=
