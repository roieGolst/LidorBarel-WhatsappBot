{
  "name": "lidor-whatsapp-bot",
  "version": "0.1.0",
  "private": true,
  "description": "Opt-in WhatsApp lead bot for Lidor Barel real estate — proactively contacts consenting Meta lead-form leads, qualifies them, syncs to Monday.com, books appointments.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc --build tsconfig.build.json",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:refresh": "docker compose down -v && docker compose up -d --wait && npm run db:migrate",
    "db:logs": "docker compose logs -f"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.2.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.9.6",
    "tsx": "^4.23.12",
    "typescript": "~5.9",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.10"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.117.1",
    "@langchain/core": "1.2.8",
    "@langchain/langgraph": "1.4.10",
    "@langchain/langgraph-checkpoint-postgres": "1.0.4",
    "bullmq": "^6.1.2",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.12.0",
    "ioredis": "^6.0.0",
    "libphonenumber-js": "^1.13.11",
    "pino": "^10.3.1",
    "postgres": "^3.4.9",
    "zod": "^4.4.3"
  }
}
